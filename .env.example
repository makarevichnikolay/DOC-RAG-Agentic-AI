# Copy this file to .env.local and fill in the keys for the providers you enable.
#
# There are THREE independent switches. The defaults below reproduce the original
# behaviour exactly (OpenAI + OpenAI + in-memory), so you can change one at a time.
#
#   LLM_PROVIDER    who writes the answer and does cloud OCR
#   EMBED_PROVIDER  who turns text into vectors
#   VECTOR_STORE    where those vectors are kept
#
# Note: a vector store is NOT an embedding provider, and Anthropic has no
# embeddings API — so LLM_PROVIDER=anthropic still needs an embedding provider
# (openai, voyage or local) underneath it.


# ─────────────────────────────────────────────────────────────
# 1. LLM — answer generation + cloud OCR
# ─────────────────────────────────────────────────────────────
# openai | anthropic
LLM_PROVIDER=openai

# --- if LLM_PROVIDER=openai ---
OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# OCR_MODEL=gpt-4o-mini

# --- if LLM_PROVIDER=anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_OCR_MODEL=claude-opus-5       # defaults to ANTHROPIC_MODEL
# ANTHROPIC_MAX_TOKENS=2048            # answer length
# ANTHROPIC_OCR_MAX_TOKENS=8192        # OCR budget — separate, so tuning answer
#                                      # length cannot truncate a scanned page
# Reasoning depth: low | medium | high | xhigh | max (or `none`).
# OPT-IN — leave it unset unless you know your model supports it. `effort` exists
# on the Opus/Sonnet tiers but NOT on Haiku 4.5, which rejects the request with
# "This model does not support the effort parameter." (400). If you set it on a
# model that lacks it, the app logs a warning and retries without it.
# On Opus, `low` keeps cost and latency down for grounded clause extraction.
# ANTHROPIC_EFFORT=low
#
# NOTE: current Claude models reject temperature/top_p (400 error), so the
# Anthropic path does not send them. Steer behaviour with the prompt instead.


# ─────────────────────────────────────────────────────────────
# 2. Embeddings — text -> vectors
# ─────────────────────────────────────────────────────────────
# openai | voyage
EMBED_PROVIDER=openai

# --- if EMBED_PROVIDER=openai ---
# EMBED_MODEL=text-embedding-3-small      # 1536 dimensions
# (uses OPENAI_API_KEY above)

# --- if EMBED_PROVIDER=voyage ---
# VOYAGE_API_KEY=pa-...
# VOYAGE_MODEL=voyage-3.5                 # general purpose, 1024 dimensions
# Voyage also publishes domain-tuned models. For contracts, check whether
# `voyage-law-2` is still current in their docs — it is trained on legal text
# and is a better fit for this corpus than a general model.

# --- if EMBED_PROVIDER=local ---
# No API key, no network once the weights are cached. Nothing extra to install:
# @huggingface/transformers arrives with `npm install` (LlamaIndex declares it as
# an optional peer). It costs ~680 MB of node_modules — do NOT try to trim that
# with `omit=optional`, which also removes Next's SWC compiler and breaks builds.
# Transformers.js runs the model in-process (ONNX on CPU); the first run also
# downloads ~90 MB of weights into node_modules/.cache.
# LOCAL_EMBED_MODEL=Xenova/all-MiniLM-L6-v2    # 384 dimensions
#
# local + the Tesseract OCR engine = nothing leaves the machine except the final
# question and the retrieved excerpts sent to the answer model.
# Trade-off: retrieval quality is below OpenAI/Voyage. It is the on-prem option,
# not the best-quality one. Its 512-token limit is also what sets MAX_CHUNK_CHARS
# (section 4) — it truncates anything longer without saying so.
# Measured after clause-aware chunking: relevant questions score 0.448-0.682,
# off-topic ones up to 0.546 — the two ranges OVERLAP, hence the 0.42 threshold
# below and the warning in README.md.


# ─────────────────────────────────────────────────────────────
# 3. Vector store — where embeddings live
# ─────────────────────────────────────────────────────────────
# memory | postgres
#   memory   — LlamaIndex in RAM. Nothing persisted; re-embeds everything on the
#              first query after every restart. Fine for a laptop demo.
#   postgres — PostgreSQL + pgvector. Embeds once, then reuses; shared by every
#              server instance. Re-embeds a client only when its contracts change
#              or the embedding model changes.
VECTOR_STORE=memory

# --- if VECTOR_STORE=postgres ---
# DATABASE_URL=postgres://user:pass@localhost:5432/contract_intel
# PGSSL=require          # managed Postgres (Neon/Supabase/RDS) usually needs this
# PG_POOL_MAX=5
#
# The database needs the pgvector extension. The app runs
# `CREATE EXTENSION IF NOT EXISTS vector` itself, which requires a role allowed
# to create extensions; otherwise run it once as a superuser:
#     CREATE EXTENSION vector;
#
# Quick local instance:
#     docker run -d --name pgvector -e POSTGRES_PASSWORD=postgres \
#       -p 5432:5432 pgvector/pgvector:pg16
#
# One table per client (chunks_<client_id>) with its own HNSW index — a query for
# one client cannot reach another's rows. Inspect with: npm run store:inspect
#
# Changing EMBED_PROVIDER or EMBED_MODEL automatically rebuilds the affected
# client's table — vectors from different models are not comparable.


# ─────────────────────────────────────────────────────────────
# 4. Retrieval tuning (provider-independent)
# ─────────────────────────────────────────────────────────────
# TOP_K=5                                 # chunks sent to the model after rerank
# RELEVANCE_THRESHOLD=                    # guardrail: below this -> refuse to answer
# MAX_CHUNK_CHARS=                        # hard ceiling on chunk size (see below)
# NEIGHBOUR_TOP_N=3                       # expand this many top hits with the
#                                         # clause either side; 0 disables it
# NEIGHBOUR_RADIUS=1                      # how many chunks either side
# EVAL_JUDGE_PROVIDER=                    # openai | anthropic — who grades the evals
# EVAL_JUDGE_MODEL=                       # which model grades them
#
# By default the judge IS the model that wrote the answer, and models grade their
# own output generously. To escape that, change the vendor, not just the model:
#   LLM_PROVIDER=anthropic + EVAL_JUDGE_PROVIDER=openai + EVAL_JUDGE_MODEL=gpt-4o
# Setting EVAL_JUDGE_MODEL alone keeps the provider from LLM_PROVIDER, so naming
# another vendor's model without EVAL_JUDGE_PROVIDER sends it to the wrong API.
# The judge provider needs its own API key.
# EVAL_CONCURRENCY=3                      # golden questions evaluated in parallel
#
# MAX_CHUNK_CHARS exists because embedding models silently TRUNCATE input past
# their context window — no error, no warning. all-MiniLM-L6-v2 stops at 512
# tokens, so before clause-aware chunking, 53 of 54 chunks in data/contracts had
# their back half invisible to semantic search. Leave it unset to get the
# default for the active embedding model:
#
#   local  (all-MiniLM-L6-v2, 512 tok)   1500   sized for the densest observed
#                                               text (3.09 chars/token in TOCs)
#   openai (8,191 tok) / voyage          3000   room to spare; smaller is sharper
#
# Leave RELEVANCE_THRESHOLD unset to get the calibrated default for whichever
# embedding model is active — every model has its own score distribution, so a
# single constant cannot serve all three:
#
#   openai (text-embedding-3-small)   0.28   NOT re-measured since chunking changed
#   local  (all-MiniLM-L6-v2)         0.42   measured — relevant/off-topic OVERLAP,
#                                            see the guardrail section in README.md
#   voyage                            0.28   NOT measured — verify before trusting
#
# This is not cosmetic: the off-topic demo question ("home address of the CEO")
# sits close to the line, so a threshold borrowed from another model can make the
# guardrail answer instead of refuse. Use the Inspector panel on the Ask screen
# to see live scores when tuning.
